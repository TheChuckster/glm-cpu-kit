# GLM-5.2 inference server - install to /etc/systemd/system/glm-server.service
# EDIT the marked lines, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now glm-server
[Unit]
Description=GLM-5.2 ik_llama.cpp server
After=network-online.target

[Service]
Type=simple
User=REPLACE_WITH_YOUR_USER

# Which model gets served. GLM_VARIANT lives here and is managed by
# `glm-model use <variant>`; anything else you add to this file is preserved
# across switches. The '-' means a missing file is not an error - serve-glm.sh
# defaults to the `base` variant.
EnvironmentFile=-/etc/default/glm-server

# Serving tuning. These are NOT model selection - they apply to whichever
# variant is active. Defaults here match the reference box; override in
# /etc/default/glm-server rather than editing the unit.
#
# THREADS must be the PHYSICAL core count. On an SMT part `nproc` reports
# double that, and oversubscribing hurts token generation badly.
# CTX: prompt processing is O(n^2). See the runbook's "Context window: the trap"
# before raising it, and keep the harness limit below this value.
# NUMA_POLICY: "distribute" for dual-socket; empty for a single NUMA domain.
# THREADS is auto-detected as the physical core count by serve-glm.sh. Set it
# here only to override - it was hardcoded to 64 for a 64-core box, which is
# correct there and wrong on any other machine this kit gets copied to.
#Environment=THREADS=64
Environment=CTX=131072
# NUMA_POLICY is auto-detected by serve-glm.sh: "distribute" when numactl reports
# more than one node, empty on a single domain. Set here only to override.
#Environment=NUMA_POLICY=

ExecStart=/usr/local/bin/serve-glm.sh
Restart=on-failure
RestartSec=5
LimitMEMLOCK=infinity
LimitNOFILE=1048576
# Loading a 340-590 GB mlocked model off NVMe takes minutes; no start timeout.
TimeoutStartSec=0
# Releasing that much mlocked memory also takes longer than the 90s default:
# systemd would SIGKILL mid-teardown, mark the unit `failed`, and leave that
# state behind after every switch - `glm-model use` restarts the service, so
# this is the normal path, not an edge case. The model is read-only, so a kill
# loses no data; this just keeps stops clean and the unit state honest.
TimeoutStopSec=600
# Keep the OOM killer away from the largest RSS on the box - it is the whole
# point of the machine, and killing it to reclaim memory helps nothing.
OOMScoreAdjust=-800

[Install]
WantedBy=multi-user.target
