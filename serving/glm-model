#!/usr/bin/env bash
# glm-model - list, download and switch the model glm-server.service serves.
#
#   glm-model list                 what is registered, downloaded, and live
#   glm-model status               active variant + server readiness
#   glm-model download <variant>   fetch shards (resumable), verify sizes/hashes
#   glm-model use <variant>        switch and restart, waiting for readiness
#   glm-model verify <variant>     re-check sizes and any pinned shard manifest
#   glm-model upstream [variant]   ask HuggingFace what each repo actually
#                                  publishes now, and whether it fits this box
#
# `use` needs root - it writes /etc/default/glm-server and restarts the unit.
# Everything else, download included, runs as your normal user.
#
# Only one variant is resident at a time: they are 155-800 GB and --mlock pins
# them, so switching is a full reload of minutes, not a hot swap.
set -uo pipefail

CONF="${GLM_VARIANTS_CONF:-/etc/glm-variants.conf}"
STATE="${GLM_STATE_FILE:-/etc/default/glm-server}"
SERVICE="${GLM_SERVICE:-glm-server.service}"
PORT="${GLM_PORT:-8080}"
MANIFEST_DIR="${GLM_MANIFEST_DIR:-/usr/local/share/glm-cpu-kit/manifests}"
# How long to wait for a switched-to model to become servable. A 460 GB model
# read off NVMe and mlocked takes minutes; too short a wait would report a
# healthy switch as a failure.
READY_TIMEOUT="${GLM_READY_TIMEOUT:-1800}"

die() { echo "glm-model: $*" >&2; exit 1; }

[ -r "$CONF" ] || die "cannot read $CONF"

# --- registry ---------------------------------------------------------------

# Emit the 9 trimmed fields of one variant, re-joined with '|', or nothing.
#
# The separator must NOT be whitespace. `subdir` is legitimately empty for a
# publisher who puts quants at the repo root, `engine` is for anything served by
# the default build, and bash `read` collapses runs of whitespace, so a
# space-joined row would silently shift every later field one to the left -
# prefix landing in subdir, shards in prefix, and so on. '|' is not IFS
# whitespace, so empty fields survive; the format already forbids '|' inside a
# field, which is what makes it safe to reuse here.
variant_row() {
    awk -F'|' -v want="$1" 'BEGIN { OFS = "|" }
        /^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
        { gsub(/^[ \t]+|[ \t]+$/, "", $1)
          if ($1 != want) next
          for (i = 2; i <= 9; i++) gsub(/^[ \t]+|[ \t]+$/, "", $i)
          print $1, $2, $3, $4, $5, $6, $7, $8, $9
          exit }
    ' "$CONF"
}

variant_names() {
    awk -F'|' '/^[[:space:]]*#/ || /^[[:space:]]*$/ { next }
              { gsub(/^[ \t]+|[ \t]+$/, "", $1); print $1 }' "$CONF"
}

# Populate globals for a variant, or die.
load_variant() {
    local row; row=$(variant_row "$1")
    [ -n "$row" ] || die "unknown variant '$1'. Known: $(variant_names | tr '\n' ' ')"
    # V_OPTS is only consumed by serve-glm.sh, but it must still be named here:
    # drop it and V_ENGINE would absorb the rest of the line.
    # shellcheck disable=SC2034
    IFS='|' read -r V_NAME V_REPO V_SUBDIR V_PREFIX V_SHARDS V_ALIAS V_DIR V_ENGINE V_OPTS <<<"$row"

    # A Hugging Face repo may be pinned as owner/name@revision. Release-day
    # quant repos can move while files are still being uploaded; resolving both
    # metadata and weights through one commit keeps a huge download internally
    # consistent. Existing rows continue to resolve `main`.
    V_REPO_SPEC="$V_REPO"
    V_REVISION=main
    if [[ "$V_REPO" != local:* && "$V_REPO" == *@* ]]; then
        V_REVISION="${V_REPO##*@}"
        V_REPO="${V_REPO%@*}"
        [ -n "$V_REPO" ] && [ -n "$V_REVISION" ] || die "invalid pinned repo '$V_REPO_SPEC'"
    fi
}

is_local_variant() {
    [[ "$V_REPO" == local:* ]]
}

# A registry shard count of `?` means "whatever the publisher shipped" - used to
# pre-stage a variant whose repo has not published yet, so the count cannot be
# known when the row is written. Resolve it from HuggingFace once and cache it,
# because download/verify need to enumerate shard names offline afterwards.
#
# Echoes the count, or nothing if it is unknown AND cannot be determined.
effective_shards() {
    if [ "$V_SHARDS" != "?" ]; then echo "$V_SHARDS"; return 0; fi
    is_local_variant && return 1
    local cache="$V_DIR/.shards" n
    if [ -r "$cache" ]; then
        n=$(tr -dc '0-9' < "$cache"); [ -n "$n" ] && { echo "$n"; return 0; }
    fi
    # Every shard is named <prefix>-000NN-of-000MM.gguf; take MM from the first
    # one we see. index() rather than a regex so a prefix containing "." (every
    # Kimi one does) is matched literally; sub() rather than gawk's 3-arg
    # match(), which mawk - the default awk on Ubuntu - does not implement.
    local sizes; sizes=$(remote_sizes)
    n=$(echo "$sizes" | awk -v p="$V_PREFIX" '
        index($1, p "-") == 1 && $1 ~ /-of-[0-9]+\.gguf$/ {
            s = $1; sub(/^.*-of-/, "", s); sub(/\.gguf$/, "", s)
            print s + 0; exit }')
    # Nothing sharded upstream, but the bare <prefix>.gguf is there: an
    # unsharded publisher (see shard_names). That is 1 file, not "unknown".
    [ -z "$n" ] && echo "$sizes" | awk -v f="$V_PREFIX.gguf" '$1 == f {exit 0} END {exit 1}' && n=1
    [ -n "$n" ] && [ "$n" -gt 0 ] 2>/dev/null || return 1
    mkdir -p "$V_DIR" 2>/dev/null && echo "$n" > "$cache" 2>/dev/null
    echo "$n"
}

# The filenames a variant is expected to consist of, one per line.
#
#   shards >= 2   <prefix>-000NN-of-000MM.gguf for NN in 1..MM   (the common case)
#   shards == 1   a single <prefix>.gguf with no suffix at all
#
# The second form is not hypothetical: ggml-org and antirez both publish
# DeepSeek-V4-Flash as ONE ~155 GB file. Publishers only shard when they must,
# and a 155 GB model is small enough that several do not bother. A model
# genuinely split into exactly one piece (-00001-of-00001) does not occur in
# practice; if one ever did, serve-glm.sh's glob would still find it and only
# `verify` would need the row corrected.
#
# Trailing newline matters: this feeds `xargs -I{}`, which splits on lines.
# Without it all shard names arrive as a single concatenated argument and every
# request 404s against a nonsense URL.
shard_names() {
    local n="$1" i
    if [ "$n" = 1 ]; then printf '%s.gguf\n' "$V_PREFIX"; return 0; fi
    for i in $(seq 1 "$n"); do printf '%s-%05d-of-%05d.gguf\n' "$V_PREFIX" "$i" "$n"; done
}

active_variant() {
    [ -r "$STATE" ] && sed -n 's/^GLM_VARIANT=//p' "$STATE" | tail -1 | tr -d '"'"'"' \n'
}

# Written by cmd_download once every shard has been size-checked against
# HuggingFace. Its presence is what "ready" means.
complete_marker() { echo "$V_DIR/.complete"; }

# Sum by glob rather than by enumerating 1..N: the shard count may be `?` until
# the publisher ships, and this must work offline. A stray or missing file
# changes the total, which is exactly what the .complete comparison wants.
#
# Both naming forms are globbed. They cannot overlap - a name either carries the
# -000NN-of-000MM suffix or it does not - so nothing is double-counted.
on_disk_bytes() {
    local total=0 sz f
    for f in "$V_DIR/$V_PREFIX"-*-of-*.gguf "$V_DIR/$V_PREFIX.gguf"; do
        [ -f "$f" ] || continue
        sz=$(stat -c %s "$f" 2>/dev/null || echo 0)
        total=$((total + sz))
    done
    echo "$total"
}

# A variant is ready only if it was verified complete AND nothing has changed
# since. Existence and non-emptiness are NOT enough: a shard being actively
# downloaded is both, so a mid-transfer variant would report ready and
# `glm-model use` would switch to a truncated model that cannot load.
is_downloaded() {
    local marker; marker=$(complete_marker)
    [ -f "$marker" ] || return 1
    local recorded; recorded=$(tr -dc '0-9' < "$marker" 2>/dev/null)
    [ -n "$recorded" ] || return 1
    [ "$(on_disk_bytes)" = "$recorded" ]
}

# Are shards currently being fetched into this directory?
is_downloading() {
    pgrep -f "curl.*$V_DIR" >/dev/null 2>&1
}

# Expected sizes from the HuggingFace API, as "filename bytes".
remote_sizes() {
    is_local_variant && return 0
    local path="$V_SUBDIR"
    curl -4 -sfL --max-time 60 \
        "https://huggingface.co/api/models/$V_REPO/tree/$V_REVISION/${path}" 2>/dev/null \
    | python3 -c '
import sys, json
try:
    for f in json.load(sys.stdin):
        p = f.get("path", "")
        if p.endswith(".gguf"):
            print(p.split("/")[-1], (f.get("lfs") or {}).get("size", 0))
except Exception:
    pass
' 2>/dev/null
}

# --- commands ---------------------------------------------------------------

cmd_list() {
    local act; act=$(active_variant)
    # ENGINE is worth a column: variants no longer all share one binary, and
    # pointing a variant at a build that cannot serve its architecture is a
    # crash-loop, not a warning.
    printf '%-16s %-10s %-12s %-10s %-24s %s\n' VARIANT STATE SIZE ENGINE ALIAS REPO
    local name
    for name in $(variant_names); do
        load_variant "$name"
        local state size
        size=$(du -shc "$V_DIR"/*.gguf 2>/dev/null | tail -1 | cut -f1)
        if is_downloaded; then
            state="ready"
        elif is_downloading; then
            state="downloading"
        elif [ -d "$V_DIR" ] && ls "$V_DIR"/*.gguf >/dev/null 2>&1; then
            state="partial"
        elif [ "$V_SHARDS" = "?" ]; then
            # Pre-staged for a quant that had not been published when the row
            # was written. Distinguished from "absent" so it does not read as
            # "just run download" - it may not exist upstream yet at all.
            state="pending"
            size="-"
        else
            state="absent"
            size="-"
        fi
        [ "$name" = "$act" ] && state="$state *live"
        printf '%-16s %-10s %-12s %-10s %-24s %s\n' \
            "$V_NAME" "$state" "${size:--}" "${V_ENGINE:-build}" "$V_ALIAS" "$V_REPO_SPEC"
    done
    echo
    echo "* = selected in $STATE (see 'glm-model status' for whether it is actually serving)"
}

cmd_status() {
    local act; act=$(active_variant)
    [ -n "$act" ] || { echo "no variant selected in $STATE"; return 1; }
    load_variant "$act"

    echo "selected variant : $V_NAME  ($V_ALIAS)"
    echo "model directory  : $V_DIR"
    echo "engine           : ${V_ENGINE:-build}"
    echo "service          : $(systemctl is-active "$SERVICE" 2>/dev/null)"

    local health
    health=$(curl -sf --max-time 5 "http://127.0.0.1:$PORT/health" 2>/dev/null)
    if [ -n "$health" ]; then
        echo "health           : $health"
        # /v1/models reports the alias, which is the only way to confirm from
        # outside that the model actually loaded is the one selected.
        local key served
        key=$(cat "$HOME/.glm-api-key" 2>/dev/null || echo "")
        served=$(curl -sf --max-time 5 -H "Authorization: Bearer $key" \
            "http://127.0.0.1:$PORT/v1/models" 2>/dev/null \
            | python3 -c 'import sys,json;print(json.load(sys.stdin)["data"][0]["id"])' 2>/dev/null)
        if [ -n "$served" ]; then
            echo "serving alias    : $served"
            [ "$served" = "$V_ALIAS" ] || \
                echo "WARNING          : serving '$served' but '$V_ALIAS' is selected - a restart is pending"
        fi
    else
        echo "health           : not responding (still loading, or stopped)"
    fi
}

cmd_download() {
    load_variant "$1"
    is_local_variant && die "$V_NAME is a local-only derivative ($V_REPO).
Populate $V_DIR out of band, then run: glm-model verify $V_NAME"
    mkdir -p "$V_DIR" || die "cannot create $V_DIR"

    local n; n=$(effective_shards) || die "$V_NAME: $V_REPO/${V_SUBDIR:-.} publishes nothing
matching '$V_PREFIX-000NN-of-000MM.gguf' or '$V_PREFIX.gguf' yet.

This variant is pre-staged for a quant that has not been released, or its
subdir/prefix in $CONF do not match what the publisher actually named the
files. Run 'glm-model upstream $V_NAME' to see what is really in the repo."

    local avail
    avail=$(df -BG --output=avail "$V_DIR" 2>/dev/null | tail -1 | tr -dc '0-9')
    echo "downloading $V_NAME from $V_REPO_SPEC ($n shards) into $V_DIR"
    echo "free space: ${avail:-?} GB"

    # IPv4 forced: HF over IPv6 stalls on some networks. Resumable and retrying
    # hard, because a 455 GB transfer will hit transient failures.
    shard_names "$n" \
    | xargs -P4 -I{} curl -4 -fL -C - --retry 1000 --retry-delay 10 --retry-all-errors \
        --progress-bar -o "$V_DIR/{}" \
        "https://huggingface.co/$V_REPO/resolve/$V_REVISION/${V_SUBDIR:+$V_SUBDIR/}{}"

    echo
    rm -f "$(complete_marker)"
    cmd_verify "$1"
}

cmd_verify() {
    load_variant "$1"
    local sizes; sizes=$(remote_sizes)
    if [ -z "$sizes" ]; then
        if is_local_variant; then
            echo "local-only derivative $V_REPO; checking registered shard presence"
        else
            echo "could not fetch expected sizes from HuggingFace; checking presence only"
        fi
    fi

    local n
    if ! n=$(effective_shards); then
        if is_local_variant; then
            die "$V_NAME: local-only variants require an explicit numeric shard count in $CONF"
        fi
        die "$V_NAME: cannot determine the shard count - neither
'$V_PREFIX-000NN-of-000MM.gguf' nor '$V_PREFIX.gguf' is published in
$V_REPO/${V_SUBDIR:-.}.
Run 'glm-model upstream $V_NAME' to see what the repo actually contains."
    fi

    # Process substitution, not a pipe: a pipe runs the loop in a subshell and
    # `bad=1` would be discarded, so an incomplete variant would verify clean.
    local name local_size want bad=0
    while read -r name; do
        local_size=$(stat -c %s "$V_DIR/$name" 2>/dev/null || echo 0)
        want=$(echo "$sizes" | awk -v n="$name" '$1 == n {print $2}')
        if [ "$local_size" -eq 0 ]; then
            printf '  %-52s MISSING\n' "$name"; bad=1
        elif [ -n "$want" ] && [ "$local_size" != "$want" ]; then
            printf '  %-52s SHORT %s / %s bytes\n' "$name" "$local_size" "$want"; bad=1
        else
            printf '  %-52s ok %6.1f GB\n' "$name" "$(echo "$local_size" | awk '{print $1/1e9}')"
        fi
    done < <(shard_names "$n")
    if [ "$bad" -ne 0 ]; then
        rm -f "$(complete_marker)"
        if is_local_variant; then
            echo "INCOMPLETE local-only derivative - restore every registered shard," >&2
            echo "then re-run 'glm-model verify $1'" >&2
        else
            echo "INCOMPLETE - re-run 'glm-model download $1' (it resumes)" >&2
        fi
        return 1
    fi

    # Optional for legacy rows, mandatory for revision-pinned rows. Size checks
    # catch interrupted transfers; the manifest additionally binds every shard
    # to the LFS object advertised by the pinned Hugging Face revision. A pin
    # without its manifest is a deployment error, not permission to silently
    # fall back to size-only verification.
    local manifest="$MANIFEST_DIR/$V_NAME.sha256"
    if [ "$V_REPO_SPEC" != "$V_REPO" ] && [ ! -r "$manifest" ]; then
        rm -f "$(complete_marker)"
        die "$V_NAME: pinned repository requires readable manifest $manifest"
    fi
    if [ -r "$manifest" ]; then
        echo "checking SHA-256 manifest: $manifest"
        (cd "$V_DIR" && sha256sum --strict -c "$manifest") || {
            rm -f "$(complete_marker)"
            die "$V_NAME: SHA-256 manifest verification failed"
        }
    fi

    # Writing the marker here rather than only in cmd_download means a variant
    # fetched by other means - or one downloaded before this check existed -
    # can be blessed with `glm-model verify <name>` instead of re-fetching
    # hundreds of gigabytes.
    on_disk_bytes > "$(complete_marker)"
    echo "$V_NAME is complete ($(du -shc "$V_DIR"/*.gguf 2>/dev/null | tail -1 | cut -f1))"
}

# Group every .gguf in a repo into "subdir<TAB>prefix<TAB>shards<TAB>bytes",
# so we can report what a publisher actually shipped rather than what the
# registry guessed they would call it.
repo_quants() {
    curl -4 -sfL --max-time 90 \
        "https://huggingface.co/api/models/$1/tree/$2?recursive=1" 2>/dev/null \
    | python3 -c '
import sys, json, re, collections
try:
    files = json.load(sys.stdin)
except Exception:
    sys.exit(0)
if not isinstance(files, list):
    sys.exit(0)
size, count = collections.Counter(), collections.Counter()
for f in files:
    p = f.get("path", "")
    if not p.endswith(".gguf"):
        continue
    sub, _, base = p.rpartition("/")
    m = re.match(r"(.*?)-\d{5}-of-\d{5}\.gguf$", base)
    key = (sub, m.group(1) if m else base[:-5])
    size[key] += (f.get("lfs") or {}).get("size") or f.get("size") or 0
    count[key] += 1
for (sub, pre) in sorted(size):
    print("%s\t%s\t%d\t%d" % (sub or ".", pre, count[(sub, pre)], size[(sub, pre)]))
' 2>/dev/null
}

# What does HuggingFace have RIGHT NOW, and would it fit in this box's RAM?
# The point of this command is the pre-staged variants: a row can be written
# before its publisher ships, and this is how you find out that they have -
# and what they actually named the files, which the registry can only guess.
cmd_upstream() {
    local ram_gb
    ram_gb=$(awk '/^MemTotal:/ {printf "%d", $2/1048576}' /proc/meminfo 2>/dev/null)
    echo "box RAM: ${ram_gb:-?} GB   (a model must fit with room for KV cache + OS)"
    echo

    local names
    if [ $# -ge 1 ]; then names="$1"; else names=$(variant_names); fi

    local name
    for name in $names; do
        load_variant "$name"
        printf '%s  ->  %s/%s\n' "$V_NAME" "$V_REPO_SPEC" "${V_SUBDIR:-.}"

        if is_local_variant; then
            echo "    local-only derivative; no HuggingFace upstream to query"
            echo
            continue
        fi

        local quants; quants=$(repo_quants "$V_REPO" "$V_REVISION")
        if [ -z "$quants" ]; then
            echo "    repo publishes no .gguf files yet (or is unreachable)"
            echo
            continue
        fi

        # Does the row's configured subdir+prefix exist upstream?
        local hit
        hit=$(echo "$quants" | awk -F'\t' -v s="${V_SUBDIR:-.}" -v p="$V_PREFIX" \
                '$1 == s && $2 == p {print; exit}')
        if [ -n "$hit" ]; then
            echo "$hit" | awk -F'\t' -v ram="${ram_gb:-0}" '
                { gb = $4/1e9
                  printf "    %-34s %2d shards  %7.1f GB   %s\n", $2, $3, gb,
                         (ram > 0 && gb < ram ? "fits" : "DOES NOT FIT") }'
        else
            echo "    configured prefix '$V_PREFIX' is NOT published in '${V_SUBDIR:-.}'"
            echo "    what the repo does have (fix subdir/prefix in $CONF to match):"
            echo "$quants" | awk -F'\t' -v ram="${ram_gb:-0}" '
                { gb = $4/1e9
                  printf "      %-14s %-32s %2d shards %7.1f GB  %s\n", $1, $2, $3, gb,
                         (ram > 0 && gb < ram ? "fits" : "too big") }'
        fi
        echo
    done
}

cmd_use() {
    load_variant "$1"
    local act; act=$(active_variant)

    if ! is_downloaded; then
        if is_downloading; then
            die "$V_NAME is still downloading ($(du -shc "$V_DIR"/*.gguf 2>/dev/null | tail -1 | cut -f1) so far). Wait for it to finish."
        fi
        if is_local_variant; then
            die "$V_NAME is not verified complete. Restore every registered shard, then run: glm-model verify $V_NAME"
        fi
        die "$V_NAME is not verified complete. Run: glm-model download $V_NAME (it resumes)"
    fi

    if [ "$act" = "$V_NAME" ] && systemctl is-active --quiet "$SERVICE"; then
        echo "$V_NAME is already selected and the service is running"
        echo "(use 'systemctl restart $SERVICE' to force a reload)"
        return 0
    fi

    echo "switching $act -> $V_NAME"
    # Rewrite ONLY the GLM_VARIANT line. This file is a normal systemd
    # EnvironmentFile and is the natural place for an operator to put THREADS,
    # CTX or NUMA_POLICY; clobbering it on every switch would silently discard
    # their tuning and change how the model is served, not just which one.
    #
    # Atomic, so a crash mid-write cannot leave the service pointing at a
    # half-written variant name.
    local tmp; tmp=$(mktemp "${STATE}.XXXXXX") || die "cannot write near $STATE"
    if [ -f "$STATE" ]; then
        grep -v '^[[:space:]]*GLM_VARIANT=' "$STATE" > "$tmp"
    else
        echo "# GLM server environment. GLM_VARIANT is managed by glm-model." > "$tmp"
    fi
    echo "GLM_VARIANT=$V_NAME" >> "$tmp"
    chmod 0644 "$tmp"
    mv "$tmp" "$STATE" || die "cannot replace $STATE"

    systemctl restart "$SERVICE" || die "restart failed"

    echo -n "loading $V_NAME (this takes minutes; $(du -shc "$V_DIR"/*.gguf 2>/dev/null | tail -1 | cut -f1) mlocked, engine ${V_ENGINE:-build})"
    local waited=0
    while [ "$waited" -lt "$READY_TIMEOUT" ]; do
        if curl -sf --max-time 5 "http://127.0.0.1:$PORT/health" >/dev/null 2>&1; then
            echo
            cmd_status
            return 0
        fi
        if ! systemctl is-active --quiet "$SERVICE"; then
            echo
            die "service died during load - check: journalctl -u $SERVICE -n 50"
        fi
        sleep 10; waited=$((waited + 10))
        echo -n "."
    done
    echo
    die "still not ready after ${READY_TIMEOUT}s - check: journalctl -u $SERVICE -n 50"
}

usage() {
    # Line range tracks the comment block at the top of this file - keep in
    # step with it when adding a command.
    sed -n '2,16p' "$0" | sed 's/^# \?//'
    exit 1
}

case "${1:-}" in
    list)     cmd_list ;;
    status)   cmd_status ;;
    download) [ $# -ge 2 ] || usage; cmd_download "$2" ;;
    verify)   [ $# -ge 2 ] || usage; cmd_verify "$2" ;;
    use)      [ $# -ge 2 ] || usage; cmd_use "$2" ;;
    upstream) shift; cmd_upstream "$@" ;;
    *)        usage ;;
esac
