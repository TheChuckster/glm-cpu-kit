[Unit]
Description=Supermicro temperature-driven fan control (PI)
Documentation=file:/usr/local/sbin/smc-fand
After=multi-user.target
# Not a hard dependency of anything: if this never starts, the BMC's own
# automatic curve keeps cooling the box. Degraded, not dangerous.

[Service]
Type=exec
EnvironmentFile=-/etc/default/smc-fand
ExecStart=/usr/local/sbin/smc-fand
Restart=on-failure
RestartSec=10s

# The safety net. Runs on EVERY exit path - clean stop, crash, panic, kill -9,
# shutdown - and hands the fans back to the BMC's Standard curve. The leading
# '-' means a failure here does not itself fail the unit. This is why the
# daemon installs no signal handlers: this covers strictly more cases.
#
# Invoking the daemon's own --restore rather than a literal ipmitool line
# matters: it honours $SMC_IPMITOOL from the EnvironmentFile above (a hardcoded
# path would silently no-op for anyone who retargets it) and it inherits the
# timeout(1) wrapper every other IPMI call uses, so a contended /dev/ipmi0
# cannot block shutdown until TimeoutStopSec fires and SIGKILLs it with the
# fans still latched in manual mode.
ExecStopPost=-/usr/local/sbin/smc-fand --restore

# Bound the stop path. The restore above is itself timeout-wrapped, so this is
# only a backstop against something else hanging.
TimeoutStopSec=30s

# /run/smc-fand for the heartbeat the independent watchdog reads.
RuntimeDirectory=smc-fand
RuntimeDirectoryMode=0755

# Runs as root because raw IPMI needs /dev/ipmi0, but gives up everything else.
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
MemoryDenyWriteExecute=true
# No network of any kind: this talks to a device node, nothing else.
PrivateNetwork=true
RestrictAddressFamilies=none
# Metrics are optional, so the path is prefixed '-': without it a host that has
# no textfile-collector directory fails namespace setup with 226/NAMESPACE and
# the fan daemon never starts at all. An absent metrics sink must not be a hard
# prerequisite for cooling.
ReadWritePaths=-/var/lib/prometheus/node-exporter
DevicePolicy=closed
DeviceAllow=/dev/ipmi0 rw

[Install]
WantedBy=multi-user.target
