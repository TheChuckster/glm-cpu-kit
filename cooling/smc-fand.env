# Configuration for smc-fand.
#
# Every value here matches the compiled-in default, so this file documents the
# shipped behaviour rather than changing it. That equivalence is deliberate:
# EnvironmentFile=- means a missing or unreadable file is silently ignored, and
# a daemon that then runs a *different* profile than this file describes is a
# trap. If you change a default in src/main.rs, change it here too.
#
# All numeric values are validated at startup. A bad value aborts before manual
# fan mode is engaged, so a misconfigured daemon leaves the BMC in charge rather
# than latching the fans and dying.

# --- control loop -----------------------------------------------------------
# Seconds per control tick. Minimum 1.
SMC_TICK_SECONDS=5

# Duty floor. Must stay clear of the BMC's fan-fail threshold (140 RPM on
# FAN4/FANB). 25% measures ~420 RPM on those fans - 3x margin. Do not lower
# this without re-checking the thresholds.
# Range 0-100, and SMC_MIN_DUTY must not exceed SMC_MAX_DUTY.
SMC_MIN_DUTY=25
SMC_MAX_DUTY=100

# Duty the controller settles at when temperature equals setpoint.
SMC_IDLE_DUTY=30

# Asymmetric slew: react fast, taper slowly.
#
# Heat arrives faster than it leaves, and the two error directions have very
# different costs: ramping up late risks throttling, while ramping down late
# costs only a little noise. So the response is deliberately lopsided, 10:1.
#
# At a 5s tick: idle -> full in ~3 ticks (15s), full -> idle in ~25 ticks
# (~2min). Emergencies bypass the limiter entirely and jump straight to 100%.
#
# Both must be POSITIVE - the downward sign is implied. Writing -3 here is
# rejected at startup rather than inverting a clamp and panicking mid-loop.
SMC_SLEW_UP=30
SMC_SLEW_DOWN=3

# --- cross-zone assist ------------------------------------------------------
# When one zone saturates at 100% and is still above setpoint, floor the other
# zone here so its unused headroom goes into cooling. Measured on this box:
# with zone 1 pegged and DIMMs at 84C, raising zone 0 from 56% to 98% pulled
# DIMMA~F down 6C and let zone 1 come off saturation entirely.
#
# Applied as a floor on the PI target, so the slew limiter still governs the
# approach. Must not exceed SMC_MAX_DUTY.
SMC_ASSIST_ENABLE=1
SMC_ASSIST_DUTY=85

# --- zone 0: FAN1-FAN4 ------------------------------------------------------
# Primary group: CPU package and VRMs. EPYC 9575F throttles around 95C.
SMC_ZONE0_SENSORS=CPU Temp,CPU_VRM0 Temp,CPU_VRM1 Temp,SOC_VRM Temp,VDDIO_VRM Temp
SMC_ZONE0_SETPOINT=70
SMC_ZONE0_EMERGENCY=90
# Aux group: the DIMMs. Zone 0 has far more authority over DIMM temperature
# than the rear exhaust does, so it watches them directly rather than relying
# on assist alone. Emergency must exceed setpoint in every group.
SMC_ZONE0_AUX_SENSORS=DIMMA~F Temp,DIMMG~L Temp
SMC_ZONE0_AUX_SETPOINT=62
SMC_ZONE0_AUX_EMERGENCY=82
SMC_ZONE0_KP=2.5
# Halved from 0.05: zone 0 hunted (65 -> 75 -> 55 -> 62 -> 58) under load while
# CPU temperature barely moved. The integral term was too eager.
SMC_ZONE0_KI=0.025

# --- zone 1: FANA/FANB ------------------------------------------------------
SMC_ZONE1_SENSORS=System Temp,Peripheral Temp,NIC Temp
SMC_ZONE1_SETPOINT=60
SMC_ZONE1_EMERGENCY=80
SMC_ZONE1_AUX_SENSORS=DIMMA~F Temp,DIMMG~L Temp
SMC_ZONE1_AUX_SETPOINT=62
SMC_ZONE1_AUX_EMERGENCY=82
SMC_ZONE1_KP=2.5
SMC_ZONE1_KI=0.025

# --- fan-failure thresholds -------------------------------------------------
# Re-asserted and read back at startup. A BMC firmware update resets these to
# the factory 420 RPM, at which point the rear Noctuas idling at 420 look like
# failed fans and the BMC restarts the full-speed ramp cycle this daemon exists
# to avoid. Format: NAME:RPM, comma separated. Set empty to disable.
SMC_FAN_THRESHOLDS=FAN4:140,FANB:140

# --- failure handling -------------------------------------------------------
# Consecutive IPMI failures - of ANY kind: sensor read, duty write, readback or
# mode check - before handing back to the BMC and exiting non-zero. Minimum 1.
SMC_MAX_FAILURES=3

# Per-call ipmitool timeout. prometheus-node-exporter-ipmitool-sensor also pokes
# /dev/ipmi0 and the kernel serialises access, so calls can block.
#
# This bounds the worst-case tick, which in turn bounds how large
# SMC_HEARTBEAT_MAX_AGE has to be: ~7 calls x 10s = 70s worst case.
SMC_CALL_TIMEOUT=10

# --- IPMI call economy ------------------------------------------------------
# Duty is only rewritten when it changes, so a steady state costs one IPMI call
# per tick instead of six. These force periodic re-verification anyway.
# Both must be >= 1; 0 is rejected at startup rather than dividing by zero.
SMC_VERIFY_EVERY=12
SMC_MODE_CHECK_EVERY=6

# --- watchdog (read by smc-fand-watchdog.sh, not the daemon) ----------------
# Heartbeat age in whole seconds before the independent watchdog forces BMC
# control. Must exceed the worst-case tick above or it will restart a healthy
# daemon under IPMI contention. Plain integer only - "120s" or "2m" are
# rejected, not silently ignored.
SMC_HEARTBEAT_MAX_AGE=120
