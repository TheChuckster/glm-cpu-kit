# Configuration for smc-fand. All values are optional; the compiled-in
# defaults match what is written here.

# --- control loop -----------------------------------------------------------
SMC_TICK_SECONDS=5
# Duty floor. Must stay clear of the BMC's fan-fail threshold (140 RPM on
# FAN4/FANB). 25% measures ~420 RPM on those fans - 3x margin. Do not lower
# this without re-checking the thresholds.
SMC_MIN_DUTY=25
SMC_MAX_DUTY=100
# Duty the controller settles at when temperature equals setpoint.
SMC_IDLE_DUTY=30

# Asymmetric slew: react fast, taper slowly.
#
# Heat arrives faster than it leaves, and the two error directions have very
# different costs: ramping up late risks throttling, while ramping down late
# costs only a little noise. So the response is deliberately lopsided, 10:1.
#
# At a 5s tick: idle -> full in ~3 ticks (15s), full -> idle in ~25 ticks
# (~2min). Emergencies bypass the limiter entirely and jump straight to 100%.
SMC_SLEW_UP=30
SMC_SLEW_DOWN=3

# --- cross-zone assist ------------------------------------------------------
# When one zone saturates at 100% and is still above setpoint, floor the other
# zone here so its unused headroom goes into cooling. Measured on this box:
# with zone 1 pegged and DIMMs at 84C, raising zone 0 from 56% to 98% pulled
# DIMMA~F down 6C and let zone 1 come off saturation entirely.
SMC_ASSIST_ENABLE=1
SMC_ASSIST_DUTY=85

# --- zone 0: FAN1-FAN4 ------------------------------------------------------
# Primary group: CPU package and VRMs. EPYC 9575F throttles around 95C.
SMC_ZONE0_SENSORS=CPU Temp,CPU_VRM0 Temp,CPU_VRM1 Temp,SOC_VRM Temp,VDDIO_VRM Temp
SMC_ZONE0_SETPOINT=70
SMC_ZONE0_EMERGENCY=90
# Aux group: the DIMMs. Zone 0 has far more authority over DIMM temperature
# than the rear exhaust does, so it watches them directly rather than relying
# on assist alone.
SMC_ZONE0_AUX_SENSORS=DIMMA~F Temp,DIMMG~L Temp
SMC_ZONE0_AUX_SETPOINT=62
SMC_ZONE0_AUX_EMERGENCY=82
SMC_ZONE0_KP=2.5
# Halved from 0.05: zone 0 hunted (65 -> 75 -> 55 -> 62 -> 58) under load while
# CPU temperature barely moved. The integral term was too eager.
SMC_ZONE0_KI=0.025

# --- zone 1: FANA/FANB ------------------------------------------------------
SMC_ZONE1_SENSORS=System Temp,Peripheral Temp,NIC Temp
SMC_ZONE1_SETPOINT=60
SMC_ZONE1_EMERGENCY=80
SMC_ZONE1_AUX_SENSORS=DIMMA~F Temp,DIMMG~L Temp
SMC_ZONE1_AUX_SETPOINT=62
SMC_ZONE1_AUX_EMERGENCY=82
SMC_ZONE1_KP=2.5
SMC_ZONE1_KI=0.025

# --- fan-failure thresholds -------------------------------------------------
# Re-asserted at startup. A BMC firmware update resets these to the factory
# 420 RPM, at which point the rear Noctuas idling at 420 look like failed fans
# and the BMC restarts the full-speed ramp cycle this daemon exists to avoid.
SMC_FAN_THRESHOLDS=FAN4:140,FANB:140

# --- failure handling -------------------------------------------------------
SMC_MAX_FAILURES=3
# Duty on the way out when we have gone blind. Deliberately high: if we cannot
# read temperatures, err toward cooling.
SMC_FAILURE_DUTY=70
SMC_CALL_TIMEOUT=15

# --- IPMI call economy ------------------------------------------------------
# Duty is only rewritten when it changes, so a steady state costs one IPMI call
# per tick instead of six. These force periodic re-verification anyway.
SMC_VERIFY_EVERY=12
SMC_MODE_CHECK_EVERY=6
