# Configuration for smc-fand.
#
# Every value here matches the compiled-in default, so this file documents the
# shipped behaviour rather than changing it. That equivalence is deliberate:
# EnvironmentFile=- means a missing or unreadable file is silently ignored, and
# a daemon that then runs a *different* profile than this file describes is a
# trap. If you change a default in src/, change it here too.
#
# All numeric values are validated at startup. A bad value aborts before manual
# fan mode is engaged, so a misconfigured daemon leaves the BMC in charge rather
# than latching the fans and dying.

# ============================================================================
# THERMAL DOMAINS
# ============================================================================
# A domain is a set of sensors sharing a thermal limit. Domains are the unit of
# control, and they are deliberately independent of fan zones: a domain says
# "these sensors must stay below this temperature", and the authority matrix
# below decides which fans have to achieve it.
#
# This is the only irreducible configuration. You must state how hot a DIMM may
# get; you should not have to state which fans cool it.
SMC_DOMAINS=cpu,dimm,periph

# CPU package and VRMs. EPYC 9575F throttles around 95C.
SMC_DOMAIN_CPU_SENSORS=CPU Temp,CPU_VRM0 Temp,CPU_VRM1 Temp,SOC_VRM Temp,VDDIO_VRM Temp
SMC_DOMAIN_CPU_SETPOINT=70
SMC_DOMAIN_CPU_EMERGENCY=90
SMC_DOMAIN_CPU_KP=2.5
# 0.025 rather than 0.05: the loop visibly hunted under load
# (65 -> 75 -> 55 -> 62 -> 58) while CPU temperature barely moved.
SMC_DOMAIN_CPU_KI=0.025

# Memory. Tighter than the CPU domain on purpose: DDR5 RDIMMs throttle around
# 85C and this board has logged a DIMM at 85C.
SMC_DOMAIN_DIMM_SENSORS=DIMMA~F Temp,DIMMG~L Temp
SMC_DOMAIN_DIMM_SETPOINT=62
SMC_DOMAIN_DIMM_EMERGENCY=82
SMC_DOMAIN_DIMM_KP=2.5
SMC_DOMAIN_DIMM_KI=0.025

# Chassis, chipset, NIC.
SMC_DOMAIN_PERIPH_SENSORS=System Temp,Peripheral Temp,NIC Temp
SMC_DOMAIN_PERIPH_SETPOINT=60
SMC_DOMAIN_PERIPH_EMERGENCY=80
SMC_DOMAIN_PERIPH_KP=2.5
SMC_DOMAIN_PERIPH_KI=0.025

# ============================================================================
# AUTHORITY: which zones can actually cool which domains
# ============================================================================
# Authority is 0..1, normalised per domain so the most effective zone is 1.0.
# 1.0 means fully coupled, and full coupling is ALWAYS SAFE: every zone runs at
# the worst domain's demand, which is at least as much cooling as any correct
# mapping. Louder, never hotter. Anything unknown falls back to 1.0.
#
#   static      - you declare it below. Deterministic; what this box ships with.
#   calibrated  - measured by `smc-fand --calibrate`, read from SMC_AUTHORITY_PATH.
#   uniform     - no information; everything couples. Safe, loudest.
SMC_AUTHORITY_MODE=static

# Static declaration: which domains each zone is responsible for.
# Zone 0 is FAN1-FAN4, zone 1 is FANA/FANB on this chassis.
#
# dimm appears in BOTH zones because measurement showed zone 0 has far more
# authority over memory temperature than the rear exhaust: raising zone 0 from
# 56% to 98% pulled DIMMA~F down 6C while zone 1 sat pegged at 100% and losing
# ground. Run --calibrate to replace this judgement with numbers.
SMC_ZONE0_DOMAINS=cpu,dimm
SMC_ZONE1_DOMAINS=periph,dimm

SMC_AUTHORITY_PATH=/var/lib/smc-fand/authority

# ============================================================================
# CALIBRATION (only used by `smc-fand --calibrate`)
# ============================================================================
# Duty levels to sweep, IN ORDER. Order matters as much as the values: a
# monotonic 25,50,75,100 sweep aliases background thermal drift onto the duty
# ramp, and the fit reads it as "more duty, hotter". Observed on this box -
# zone 1 measured +0.02 C/%, impossible for a fan.
#
# 50,100,25,75 is balanced: cov(step_time, duty) == 0, so linear drift cancels
# out of the least-squares slope exactly. Full range gives strongest signal for
# low-authority pairs where the response is near the noise floor.
SMC_CALIBRATE_STEPS=50,100,25,75
# Seconds to wait after each step before sampling. DIMM thermal mass is the
# constraint; too short and you measure the transient, not the steady state.
SMC_CALIBRATE_SETTLE=120
SMC_CALIBRATE_SAMPLES=5
# Duty held on the zones NOT being swept, so only one variable moves.
SMC_CALIBRATE_HOLD_DUTY=60
# Abort the sweep if any sensor comes within this many degrees of its domain's
# emergency threshold. A measurement is never worth cooking the box for.
SMC_CALIBRATE_ABORT_MARGIN=8
SMC_CALIBRATE_LOCK=/run/smc-fand/calibrating
# Settle time in seconds around each discovery probe. The baseline is
# re-measured before every probe, and fans take tens of seconds to spin down -
# too short and a coasting fan gets attributed to the next zone tested.
SMC_DISCOVER_SETTLE=45
# Highest zone id to probe during discovery.
SMC_MAX_ZONE_PROBE=4

# ============================================================================
# DRIFT DETECTION
# ============================================================================
# Watches whether the measured response still matches the calibrated matrix -
# a fan was swapped, a shroud added, a filter clogged. It ONLY flags; it never
# retunes control. Passive learning cannot feed the controller here because
# duty correlates with load, so passively observed data says "more fans =>
# hotter". Only calibration, which chooses the duty itself, breaks that.
SMC_DRIFT_ENABLE=1
# Relative disagreement (0..1) before flagging.
SMC_DRIFT_TOLERANCE=0.35

# ============================================================================
# CONTROL LOOP
# ============================================================================
SMC_TICK_SECONDS=5

# Duty floor. Must stay clear of the BMC's fan-fail threshold (140 RPM on
# FAN4/FANB). 25% measures ~420 RPM on those fans - 3x margin. Do not lower
# this without re-checking the thresholds.
SMC_MIN_DUTY=25
SMC_MAX_DUTY=100
# Duty a domain settles at when its temperature equals its setpoint.
SMC_IDLE_DUTY=30

# Asymmetric slew: react fast, taper slowly.
#
# Heat arrives faster than it leaves, and the two error directions have very
# different costs: ramping up late risks throttling, while ramping down late
# costs only a little noise. So the response is deliberately lopsided, 10:1.
#
# At a 5s tick: idle -> full in ~3 ticks (15s), full -> idle in ~25 ticks
# (~2min). Emergencies bypass the limiter entirely and jump straight to 100%.
#
# Both must be POSITIVE - the downward sign is implied.
SMC_SLEW_UP=30
SMC_SLEW_DOWN=3

# ============================================================================
# FAN-FAILURE THRESHOLDS
# ============================================================================
# Re-asserted and read back at startup. A BMC firmware update resets these to
# the factory 420 RPM, at which point the rear Noctuas idling at 420 look like
# failed fans and the BMC restarts the full-speed ramp cycle this daemon exists
# to avoid. Format: NAME:RPM, comma separated. Set empty to disable.
SMC_FAN_THRESHOLDS=FAN4:140,FANB:140

# Duty floor used when those thresholds could NOT be read back as set. Idling at
# SMC_MIN_DUTY under a threshold the BMC still enforces recreates the original
# ~20s ramp cycle, so the daemon runs higher instead. It does not refuse to
# start: handing back to the BMC would idle the fans lower still.
SMC_UNVERIFIED_MIN_DUTY=45

# ============================================================================
# FAILURE HANDLING
# ============================================================================
# Consecutive IPMI failures - of ANY kind: sensor read, duty write, readback or
# mode check - before handing back to the BMC and exiting non-zero. Minimum 1.
SMC_MAX_FAILURES=3

# Per-call ipmitool timeout. prometheus-node-exporter-ipmitool-sensor also pokes
# /dev/ipmi0 and the kernel serialises access, so calls can block. This bounds
# the worst-case tick, which bounds how large SMC_HEARTBEAT_MAX_AGE must be:
# ~7 calls x 10s = 70s worst case.
SMC_CALL_TIMEOUT=10

# Duty is only rewritten when it changes, so a steady state costs one IPMI call
# per tick instead of six. These force periodic re-verification anyway.
# Both must be >= 1; 0 is rejected at startup rather than dividing by zero.
SMC_VERIFY_EVERY=12
SMC_MODE_CHECK_EVERY=6

# ============================================================================
# WATCHDOG (read by smc-fand-watchdog.sh, not the daemon)
# ============================================================================
# Heartbeat age in whole seconds before the independent watchdog forces BMC
# control. Must exceed the worst-case time to the FIRST heartbeat, not just the
# steady-state tick: startup does sensor resolution, threshold verification and
# tick one, roughly 13 serialised ipmitool calls, so ~130s at a 10s call
# timeout. Below that the watchdog restarts a healthy daemon during every start.
# Plain integer only - "180s" or "3m" are rejected, not silently ignored.
SMC_HEARTBEAT_MAX_AGE=180

# The calibration lock now carries its own expiry, computed from the sweep's
# length, so there is no separate stand-down interval to configure.
